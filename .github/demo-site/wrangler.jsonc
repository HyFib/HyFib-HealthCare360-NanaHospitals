// The demo (src/web/demo/README.md) on Cloudflare: a Worker with static assets only, so no Worker script runs. The
// Demo site workflow puts src/web/demo/site, as committed, and _headers into dist/ and deploys it.
//
// The first deploy creates the Worker and its Custom Domain, hc360.hyfib.com, for which Cloudflare makes the DNS record
// and the certificate. Each deploy keeps the domain attached, so the deploy token can edit the hyfib.com zone's
// Workers routes (src/web/demo/README.md).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hc360-demo",
	"compatibility_date": "2026-10-16",
	"assets": {
		"directory": "./dist"
	},
	// One public address, the Custom Domain: no workers.dev address, and no preview address for each version.
	"routes": [{ "pattern": "hc360.hyfib.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
