<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Every element of a Firely FHIR resource is optional, so the SDK annotates them all as nullable. The assertions here
      read those elements directly (a missing one fails the test with a NullReferenceException or a Shouldly message),
      so the nullable dereference warnings are noise in this project only.
    -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\server\Modules\HyFib.HealthCare360.Modules.Interop\HyFib.HealthCare360.Modules.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validates the ABDM bundles against the NRCeS profiles in TestData (EHR-08); versions in Directory.Packages.props. -->
    <PackageReference Include="Firely.Fhir.Validation.R4" />
    <PackageReference Include="Hl7.Fhir.Specification.Data.R4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The NRCeS ndhm.in 6.5.0 files the validator reads at run time (TestData/ndhm.in-6.5.0/README.md says where from). -->
    <None Update="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
