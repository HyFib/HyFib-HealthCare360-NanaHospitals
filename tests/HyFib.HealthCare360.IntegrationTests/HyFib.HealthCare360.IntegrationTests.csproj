<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end journeys (SRS §9) through the whole server, its real middleware and endpoints, against PostgreSQL.
    The database comes from HC360_TEST_DATABASE when set (CI), otherwise from a throwaway Docker container.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\server\HyFib.HealthCare360.Server\HyFib.HealthCare360.Server.csproj" />
    <!-- The load test's steps, run against the whole server (LoadTestTests). -->
    <ProjectReference Include="..\..\tools\HyFib.HealthCare360.LoadTest\HyFib.HealthCare360.LoadTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <!--
      AbdmExportTests validate the downloaded ABDM bundles against the NRCeS profiles, with the Interop module tests'
      validator and implementation guide files (EHR-08).
    -->
    <PackageReference Include="Firely.Fhir.Validation.R4" />
    <PackageReference Include="Hl7.Fhir.Specification.Data.R4" />
    <Compile Include="..\Modules\HyFib.HealthCare360.Modules.Interop.Tests\Abdm\AbdmProfileValidator.cs" Link="Abdm\AbdmProfileValidator.cs" />
    <None Include="..\Modules\HyFib.HealthCare360.Modules.Interop.Tests\TestData\**\*.json" Link="TestData\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
