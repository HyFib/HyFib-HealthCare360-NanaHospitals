<Window x:Class="HyFib.HealthCare360.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HealthCare360"
        Icon="Assets/hc360.ico"
        Width="1366" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Transparent" />

    <!-- Shown while the server cannot be reached; retries on its own. -->
    <Border x:Name="OfflinePanel" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
        <Image Source="Assets/hc360-256.png" Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,16" />
        <TextBlock x:Name="OfflineTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Text="Connecting to HealthCare360…" />
        <TextBlock x:Name="OfflineMessage" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                   Text="Checking the connection to the hospital server." />
        <TextBlock x:Name="OfflineDetails" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.65" />
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button x:Name="RetryButton" Content="Try again now" Padding="16,6" Click="OnRetryClick" />
          <Button x:Name="ChangeServerButton" Content="Change server…" Padding="16,6" Margin="8,0,0,0" Click="OnChangeServerClick" />
          <!-- Shown once a new version of HC360 Desktop is ready to install (SRS DED-18). -->
          <Button x:Name="RestartToUpdateButton" Content="Restart to update" Padding="16,6" Margin="8,0,0,0" Visibility="Collapsed" Click="OnRestartToUpdateClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
