{
  "ConnectionStrings": {
    "Hospital": "Host=localhost;Port=5432;Database=hc360;Username=hc360_app;Password=SET_BY_INSTALLER;Maximum Pool Size=200;Timeout=15;Command Timeout=60"
  },
  "HealthCare360": {
    "HttpsPort": 7360,
    "PortalHttpsPort": 7361,
    "ApiReferencePort": 7362,
    "HttpRedirectPort": 0,
    "DefaultFacilityCode": "NH",
    "DefaultFacilityName": "Nana Hospitals",
    "TimeZone": "Asia/Kolkata",
    "AutoMigrate": true,
    "SeedDemoData": false,
    "Role": "all",
    "EnableApiReference": false,
    "Security": {
      "AccessTokenMinutes": 10,
      "SessionHours": 12,
      "SessionIdleMinutes": 120,
      "MaxFailedLogins": 5,
      "LockoutMinutes": 15,
      "MinPasswordLength": 12,
      "EnforceMfa": true,
      "MfaRequiredRoles": [ "SuperAdmin", "HospitalAdmin", "Accountant", "HrManager" ]
    },
    "Network": {
      "EnableMdns": true,
      "MdnsServiceType": "_hc360._tcp",
      "EnableWifiMonitor": true,
      "WifiSampleSeconds": 30,
      "WifiWeakSignalThreshold": 40,
      "GenerateLanCertificate": true
    },
    "Backup": {
      "Enabled": true,
      "Schedule": "0 30 1 * * ?",
      "BeforeMigrations": true,
      "Retention": { "Daily": 14, "Weekly": 8, "Monthly": 12 },
      "UpkeepSchedule": "0 30 3 * * ?",
      "TestRestore": { "Enabled": true, "EveryDays": 7, "WarnAfterDays": 14, "CheckRoom": true },
      "CopyCheckDays": 7,
      "PointInTimeDays": 30,
      "DiskRotationDays": 7,
      "PgDumpPath": "pg_dump"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
