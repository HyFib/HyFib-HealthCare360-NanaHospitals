{
  "ConnectionStrings": {
    "Hospital": "Host=localhost;Port=57360;Database=hc360;Username=hc360;Maximum Pool Size=50"
  },
  "HealthCare360": {
    "DataDirectory": "../../../hc360-data",
    "SeedDemoData": true,
    "EnableApiReference": true,
    "Bootstrap": {
      "RequirePasswordChange": false
    },
    "Security": {
      "EnforceMfa": false
    },
    "Network": {
      "EnableWifiMonitor": true
    },
    "Backup": {
      "Enabled": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Quartz": "Warning"
      }
    }
  }
}
