<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    HC360 Server: the composition root that runs on the dedicated Server Node as a Windows Service.
    Hosts the API, SignalR hubs, background jobs, the staff UI (wwwroot) and the Patient Portal (wwwroot/portal).
  -->
  <PropertyGroup>
    <RootNamespace>HyFib.HealthCare360.Server</RootNamespace>
    <AssemblyName>HyFib.HealthCare360.Server</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <IsPackable>false</IsPackable>
    <!-- Development credentials live in .NET user secrets, never in the repository (see README). -->
    <UserSecretsId>76ca40ee-b69b-476c-a6bf-d89ef6a0043a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyFib.HealthCare360.Platform\HyFib.HealthCare360.Platform.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Patients\HyFib.HealthCare360.Modules.Patients.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Scheduling\HyFib.HealthCare360.Modules.Scheduling.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Clinical\HyFib.HealthCare360.Modules.Clinical.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Diagnostics\HyFib.HealthCare360.Modules.Diagnostics.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.SupplyChain\HyFib.HealthCare360.Modules.SupplyChain.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Pharmacy\HyFib.HealthCare360.Modules.Pharmacy.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Inpatient\HyFib.HealthCare360.Modules.Inpatient.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.VirtualCare\HyFib.HealthCare360.Modules.VirtualCare.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.SpecialtyCare\HyFib.HealthCare360.Modules.SpecialtyCare.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.SupportServices\HyFib.HealthCare360.Modules.SupportServices.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Billing\HyFib.HealthCare360.Modules.Billing.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.HR\HyFib.HealthCare360.Modules.HR.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Engagement\HyFib.HealthCare360.Modules.Engagement.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Quality\HyFib.HealthCare360.Modules.Quality.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.AI\HyFib.HealthCare360.Modules.AI.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Analytics\HyFib.HealthCare360.Modules.Analytics.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Interop\HyFib.HealthCare360.Modules.Interop.csproj" />
    <ProjectReference Include="..\Modules\HyFib.HealthCare360.Modules.Privacy\HyFib.HealthCare360.Modules.Privacy.csproj" />
    <ProjectReference Include="..\HyFib.HealthCare360.Integrations\HyFib.HealthCare360.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyFib.HealthCare360.IntegrationTests" />
  </ItemGroup>
</Project>
