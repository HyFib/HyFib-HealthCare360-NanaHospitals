<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-cutting platform: persistence, security/identity, audit, numbering, outbox, idempotency,
    realtime, files, settings, organisation masters, integration abstractions and LAN networking
    (certificates, mDNS, WiFi monitoring) for the dedicated Server Node.
  -->
  <PropertyGroup>
    <RootNamespace>HyFib.HealthCare360.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyFib.HealthCare360.SharedKernel\HyFib.HealthCare360.SharedKernel.csproj" />
    <ProjectReference Include="..\..\shared\HyFib.HealthCare360.WindowsInterop\HyFib.HealthCare360.WindowsInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Security\Resources\common-passwords.txt" />
    <EmbeddedResource Include="Security\Resources\breached-passwords.gcs" />
    <EmbeddedResource Include="Localization\Resources\patient-texts-*.json" />
    <EmbeddedResource Include="Documents\Fonts\*.woff2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyFib.HealthCare360.UnitTests" />
    <InternalsVisibleTo Include="HyFib.HealthCare360.Platform.Tests" />
    <InternalsVisibleTo Include="HyFib.HealthCare360.IntegrationTests" />
  </ItemGroup>
</Project>
