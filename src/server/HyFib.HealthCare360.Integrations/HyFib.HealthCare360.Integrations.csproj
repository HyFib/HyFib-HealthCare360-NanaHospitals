<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Adapters for external systems (SRS §5): SMS, WhatsApp, e-mail, Tally, payment gateway, POS, PACS/DICOMweb,
    laboratory analysers (HL7/ASTM over TCP), biometric attendance, barcode/label printing and ICD lookup.
    Every adapter has a Simulator provider so the hospital can train without real credentials.
  -->
  <PropertyGroup>
    <RootNamespace>HyFib.HealthCare360.Integrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyFib.HealthCare360.Platform\HyFib.HealthCare360.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="HyFib.HealthCare360.SharedKernel" />
    <Using Include="HyFib.HealthCare360.Platform.Modules" />
    <Using Include="HyFib.HealthCare360.Platform.Persistence" />
    <Using Include="HyFib.HealthCare360.Platform.Security" />
    <Using Include="HyFib.HealthCare360.Platform.Http" />
    <Using Include="HyFib.HealthCare360.Platform.Integrations" />
    <Using Include="HyFib.HealthCare360.Platform.Settings" />
    <Using Include="HyFib.HealthCare360.Platform.Auditing" />
    <Using Include="HyFib.HealthCare360.Platform.Contracts" />
    <Using Include="HyFib.HealthCare360.Platform.Hosting" />
    <Using Include="HyFib.HealthCare360.Integrations.Common" />
    <Using Include="System.Text.Json" />
    <Using Include="FluentValidation" />
    <Using Include="Microsoft.EntityFrameworkCore" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyFib.HealthCare360.Integrations.Tests" />
    <!-- The lab agent's tests run the server's relay and protocol session end to end. -->
    <InternalsVisibleTo Include="HyFib.HealthCare360.LabAgent.Tests" />
    <!-- NSubstitute (Castle DynamicProxy) proxies internal adapter interfaces in the unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
